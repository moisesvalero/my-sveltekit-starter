{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/routes/**/+*.{ts,svelte}",
    "src/hooks.{client,server}.ts",
    "src/app.{d,html}",
    "scripts/*.js"
  ],
  "ignore": ["src/lib/server/payments/**", "src/lib/payments/**", "src/lib/server/auth.ts"],
  "project": ["src/**/*.{ts,svelte}", "scripts/**/*.js"],
  "ignoreFiles": [
    "src/lib/actions/**",
    "src/lib/components/ui/{dialog/**,FaqSection.svelte,FeaturesSection.svelte,HeroSection.svelte,PricingTable.svelte,WaitlistForm.svelte}",
    "src/lib/server/security/**",
    "src/lib/index.ts",
    "src/lib/auth-client.ts"
  ],
  "ignoreDependencies": [
    "@sanity/client",
    "@sanity/image-url",
    "@supabase/supabase-js",
    "lint-staged",
    "@polar-sh/better-auth",
    "@polar-sh/sdk"
  ],
  "husky": false,
  "lint-staged": false,
  "ignoreIssues": {
    "src/lib/aeo/index.ts": ["exports", "types"],
    "src/lib/aeo/headers.ts": ["exports"],
    "src/lib/aeo/paths.ts": ["exports"],
    "src/lib/aeo/shared.ts": ["exports"],
    "src/lib/components/ui/**/index.ts": ["exports", "types"],
    "src/lib/i18n/site-locale.ts": ["exports"],
    "src/lib/seo.ts": ["exports"],
    "src/lib/site-pages.ts": ["exports", "types"],
    "src/lib/stores/toast.ts": ["exports"],
    "src/lib/utils.ts": ["types"]
  },
  "ignoreExportsUsedInFile": true
}
