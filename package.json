{
  "name": "my-sveltekit-starter",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:password@localhost:5432/sveltekit_agent_db} prisma generate && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync && husky || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint src scripts sanity *.ts *.js",
    "knip": "knip",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "new:page": "node scripts/new-page.js",
    "clean": "node scripts/clean.js",
    "studio": "sanity dev",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "verify": "pnpm run lint && pnpm run knip && pnpm run check && pnpm run format:check && pnpm run test && pnpm run build",
    "verify:release": "node --experimental-strip-types scripts/verify-release.ts",
    "agent:skills": "pnpm dlx autoskills",
    "agent:impeccable": "pnpm dlx autoskills install impeccable"
  },
  "lint-staged": {
    "*.{js,ts,svelte}": [
      "oxlint --fix",
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "cookie": "0.7.2",
      "js-yaml": "3.14.2",
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.66.0",
    "@sveltejs/adapter-vercel": "^7.0.2",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "husky": "^9.1.7",
    "knip": "^6.44.1",
    "lint-staged": "^17.6.0",
    "mdsvex": "^0.12.8",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prisma": "7.10.1",
    "sanity": "^6.21.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwind-variants": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@polar-sh/better-auth": "^1.8.4",
    "@polar-sh/sdk": "^0.49.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sanity/client": "^7.22.0",
    "@sanity/image-url": "^2.1.1",
    "@sentry/sveltekit": "^10.52.0",
    "@supabase/supabase-js": "^2.105.4",
    "better-auth": "^1.7.14",
    "bits-ui": "^2.20.2",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "pg": "^8.23.1",
    "svelte-sonner": "^1.2.2",
    "tailwind-merge": "^3.7.0"
  }
}
