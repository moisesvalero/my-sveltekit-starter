{
  "name": "my-sveltekit-starter",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync && husky || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint src scripts sanity *.ts *.js",
    "knip": "knip",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "new:page": "node scripts/new-page.js",
    "clean": "node scripts/clean.js",
    "studio": "sanity dev",
    "verify": "pnpm run lint && pnpm run knip && pnpm run check && pnpm run format:check && pnpm run test && pnpm run build",
    "agent:skills": "pnpm dlx autoskills",
    "agent:impeccable": "pnpm dlx autoskills install impeccable"
  },
  "lint-staged": {
    "*.{js,ts,svelte}": [
      "oxlint --fix",
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "cookie": "0.7.2",
      "js-yaml": "3.14.2",
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.1",
    "@lucide/svelte": "^1.14.0",
    "@sveltejs/adapter-vercel": "^6.3.3",
    "@sveltejs/kit": "^2.69.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.1",
    "husky": "^9.1.7",
    "knip": "^6.29.0",
    "lint-staged": "^16.2.7",
    "mdsvex": "^0.12.3",
    "oxlint": "^1.76.0",
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^3.4.0",
    "sanity": "^5.24.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.4.2",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@sanity/client": "^7.22.0",
    "@sanity/image-url": "^2.1.1",
    "@sentry/sveltekit": "^10.52.0",
    "@supabase/supabase-js": "^2.105.4",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.6.0"
  }
}
